---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { SITE, absoluteUrl } from '../../../config/site';
import { breadcrumbs, graph, organization, webPage } from '../../../lib/schema';
import { fmtDate, isoDate } from '../../../lib/format';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({ params: { slug: app.id }, props: { app } }));
}

interface Props { app: CollectionEntry<'apps'> }
const { app } = Astro.props;
const d = app.data;
const p = d.privacy;
const appPath = `/apps/${app.id}`;
const path = `${appPath}/privacy`;
const title = `${d.name} Privacy Policy | ${SITE.domain}`;
const description = `How ${d.name} by ${SITE.name} handles your data: what is collected, why, who it is shared with, and how to contact us.`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: d.name, path: appPath },
  { name: 'Privacy', path },
];
const jsonLd = graph(
  organization(),
  webPage({ path, name: title, description, dateModified: p.lastUpdated, about: `${absoluteUrl(appPath)}#app` }),
  breadcrumbs(crumbs),
);
---
<BaseLayout title={title} description={description} image={d.ogImage} jsonLd={jsonLd}>
  <article class="wrap pt-8">
    <Breadcrumbs items={crumbs} />
    <header class="mt-12 border-b-2 border-ink pb-10">
      <p class="label">Legal · {d.name}</p>
      <h1 class="mt-5 font-display text-giga font-extrabold uppercase tracking-tighter">Privacy<span class="text-accent">.</span></h1>
      <p class="label mt-6 text-muted">Last updated <time datetime={isoDate(p.lastUpdated)}>{fmtDate(p.lastUpdated)}</time></p>
    </header>

    <div class="prose-ed mt-10">
      <!-- PLACEHOLDER POLICY: review with a legal professional before submitting to the App Store / Google Play. -->
      <p><strong>In short:</strong> {d.name} does not sell your personal data, does not require an account with us, and collects only the minimum needed to make the {d.type} work and fix bugs.</p>

      <h2>Who we are</h2>
      <p>{d.name} is developed and published by {SITE.name} ("we", "us"). You can contact us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>

      <h2>What data we collect</h2>
      {p.dataCollected.length ? (
        <ul>
          {p.dataCollected.map((x) => <li><strong>{x.type}</strong>: {x.purpose}</li>)}
        </ul>
      ) : (
        <p>We do not collect any personal data.</p>
      )}

      <h2>Third-party services</h2>
      {p.thirdParties.length ? (
        <>
          <p>{d.name} uses the following third-party services, which may collect data under their own privacy policies:</p>
          <ul>{p.thirdParties.map((t) => <li><a href={t.url} rel="noopener" target="_blank">{t.name}</a>{t.purpose && <>: {t.purpose}</>}</li>)}</ul>
          <p>{d.name} does not use advertising or analytics services.</p>
        </>
      ) : (
        <p>{d.name} does not use third-party advertising or analytics services.</p>
      )}

      <h2>Children's privacy</h2>
      <p>{d.name} is not directed at children under 13, and we do not knowingly collect personal information from children. If you believe a child has given us personal information, contact us and we will delete it.</p>

      <h2>Data retention and deletion</h2>
      <p>{p.retention ?? 'Game progress is stored on your device and is removed when you delete the app.'} To ask us to delete any data we hold about you, email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>

      <h2>Your rights</h2>
      <p>Depending on where you live, you may have the right to access, correct or delete your personal data, or to object to how it is processed. Email us to exercise these rights.</p>

      <h2>Changes to this policy</h2>
      <p>We may update this policy from time to time. The date at the top of this page shows when it last changed.</p>

      <h2>Contact</h2>
      <p>Questions about this policy? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or visit the <a href={`${appPath}/support`}>{d.name} support page</a>.</p>
    </div>
  </article>
</BaseLayout>
