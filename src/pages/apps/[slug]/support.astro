---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Faq from '../../../components/Faq.astro';
import { SITE, absoluteUrl } from '../../../config/site';
import { breadcrumbs, faq, graph, organization, webPage } from '../../../lib/schema';
import { fmtDate, isoDate, platformLabel } from '../../../lib/format';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({ params: { slug: app.id }, props: { app } }));
}

interface Props { app: CollectionEntry<'apps'> }
const { app } = Astro.props;
const d = app.data;
const appPath = `/apps/${app.id}`;
const path = `${appPath}/support`;
const title = `${d.name} Support — Help, FAQ & Contact | ${SITE.domain}`;
const description = `Get help with ${d.name}: answers to common questions, troubleshooting tips, and how to contact ${SITE.name} at ${SITE.email}.`;
const subject = encodeURIComponent(`${d.name} support`);
const body = encodeURIComponent(`Hi ${SITE.name},\n\nDevice model:\nOS version:\nGame version:\n\nWhat happened:\n`);
const mailto = `mailto:${SITE.email}?subject=${subject}&body=${body}`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: d.name, path: appPath },
  { name: 'Support', path },
];

const tips = d.support.tips.length
  ? d.support.tips
  : [
      'Make sure you have the latest version of the app from the App Store or Google Play.',
      'Restart the app, then restart your device.',
      'Check that your device runs a supported OS version (listed above).',
    ];

const jsonLd = graph(
  organization(),
  { ...webPage({ type: 'ContactPage', path, name: title, description, dateModified: d.support.lastUpdated, about: `${absoluteUrl(appPath)}#app` }) },
  ...(d.faq.length ? [faq(d.faq)] : []),
  breadcrumbs(crumbs),
);
---
<BaseLayout title={title} description={description} image={d.ogImage} jsonLd={jsonLd}>
  <section class="wrap pt-8 pb-14">
    <Breadcrumbs items={crumbs} />
    <div class="mt-12 flex items-center gap-4">
      <Image src={d.icon} alt="" width={64} height={64} loading="eager" class="size-14 rounded-[22%] border-2 border-ink" />
      <span class="label">Support · {d.name}</span>
    </div>
    <h1 class="mt-6 font-display text-giga font-extrabold uppercase tracking-tighter">Need a hand<span class="text-accent">?</span></h1>
    <p class="mt-8 max-w-3xl text-xl leading-relaxed md:text-2xl">
      For help with <a href={appPath} class="font-semibold underline decoration-accent decoration-2 underline-offset-4">{d.name}</a>, email <a href={mailto} class="font-semibold underline decoration-accent decoration-2 underline-offset-4">{SITE.email}</a>. Replies usually arrive within {SITE.responseTime}. Answers to the most common questions are below.
    </p>
  </section>

  <section class="wrap" aria-labelledby="contact-title">
    <div class="grid border-2 border-ink md:grid-cols-12">
      <div class="bg-accent p-6 text-accent-ink md:col-span-7 md:p-12">
        <h2 id="contact-title" class="font-display text-4xl font-extrabold uppercase leading-none tracking-tight md:text-6xl">Email support</h2>
        <p class="mt-5 max-w-lg text-lg">Include your device model, OS version and the game version (shown in Settings). Screenshots help a lot.</p>
        <a href={mailto} class="btn mt-8 hover:!bg-paper hover:!text-ink">Write to {SITE.email} <span aria-hidden="true">→</span></a>
      </div>
      <div class="border-t-2 border-ink p-6 md:col-span-5 md:border-t-0 md:border-l-2 md:p-12">
        <h2 class="label">Requirements</h2>
        <dl class="mt-5 divide-y divide-line">
          {d.platforms.includes('ios') && d.support.minIos && (
            <div class="flex justify-between py-3"><dt class="text-muted">iOS / iPadOS</dt><dd class="font-semibold">{d.support.minIos} or later</dd></div>
          )}
          {d.platforms.includes('android') && d.support.minAndroid && (
            <div class="flex justify-between py-3"><dt class="text-muted">Android</dt><dd class="font-semibold">{d.support.minAndroid} or later</dd></div>
          )}
          <div class="flex justify-between py-3"><dt class="text-muted">Platforms</dt><dd class="font-semibold">{d.platforms.map(platformLabel).join(', ')}</dd></div>
          <div class="flex justify-between py-3"><dt class="text-muted">Reply time</dt><dd class="font-semibold">~{SITE.responseTime}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="wrap py-20" aria-labelledby="tips-title">
    <div class="grid gap-10 md:grid-cols-12">
      <h2 id="tips-title" class="font-display text-4xl font-extrabold uppercase leading-none tracking-tight md:col-span-4 md:text-5xl">Quick fixes</h2>
      <ol class="space-y-0 border-t-2 border-ink md:col-span-8">
        {tips.map((t, i) => (
          <li class="flex gap-6 border-b-2 border-ink py-5 text-lg">
            <span class="font-mono text-accent font-medium" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span>{t}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {d.faq.length > 0 && (
    <section class="wrap pb-10" aria-labelledby="faq-title">
      <div class="grid gap-10 md:grid-cols-12">
        <h2 id="faq-title" class="font-display text-4xl font-extrabold uppercase leading-none tracking-tight md:col-span-4 md:text-5xl">{d.name} FAQ</h2>
        <div class="md:col-span-8"><Faq items={d.faq} /></div>
      </div>
    </section>
  )}

  <section class="wrap pt-10">
    <p class="label text-muted">
      Last updated <time datetime={isoDate(d.support.lastUpdated)}>{fmtDate(d.support.lastUpdated)}</time> ·
      <a href={`${appPath}/privacy`} class="underline underline-offset-4 hover:text-ink">Privacy policy</a>
    </p>
  </section>
</BaseLayout>
