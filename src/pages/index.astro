---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';
import AppCard from '../components/AppCard.astro';
import { SITE } from '../config/site';
import { graph, organization, website, webPage } from '../lib/schema';

const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
const jsonLd = graph(
  organization(),
  website(),
  webPage({ type: 'CollectionPage', path: '/', name: SITE.title, description: SITE.description }),
  {
    '@type': 'ItemList',
    name: `Apps by ${SITE.name}`,
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}/apps/${a.id}`,
      name: a.data.name,
    })),
  },
);
---
<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <section class="wrap pt-14 pb-16 md:pt-24 md:pb-24">
    <p class="label flex items-center gap-3">
      <span class="inline-block size-2.5 bg-accent" aria-hidden="true"></span>
      Independent studio · Est. 2026
    </p>
    <h1 class="mt-8 font-display text-mega font-extrabold uppercase tracking-tighter">
      Small<br />games<span class="text-accent">&</span><br class="sm:hidden" /> apps<span class="text-accent">.</span>
    </h1>
    <div class="mt-12 grid gap-8 md:grid-cols-12">
      <p class="text-xl leading-relaxed md:col-span-6 md:col-start-7 md:text-2xl">
        <strong class="font-semibold">{SITE.domain}</strong> is an independent studio by {SITE.author} making small, polished mobile games and apps for iOS and Android. Simple to pick up, made with care.
      </p>
    </div>
  </section>

  <Marquee items={apps.map((a) => a.data.status === 'live' ? `${a.data.name} out now` : `${a.data.name} coming soon`).concat(['iOS', 'Android'])} />

  <section id="apps" class="wrap scroll-mt-8 py-20 md:py-28" aria-labelledby="apps-title">
    <div class="flex items-end justify-between gap-6 border-b-2 border-ink pb-6">
      <h2 id="apps-title" class="font-display text-giga font-extrabold uppercase tracking-tighter">Apps</h2>
      <span class="label pb-2">{String(apps.length).padStart(2, '0')} project{apps.length === 1 ? '' : 's'}</span>
    </div>
    <ul class="mt-10 space-y-6">
      {apps.map((app, i) => <li><AppCard app={app} index={i} /></li>)}
    </ul>
  </section>

  <section class="wrap" aria-labelledby="about-title">
    <div class="grid gap-10 border-2 border-ink bg-paper-2 p-6 md:grid-cols-12 md:p-12">
      <h2 id="about-title" class="font-display text-4xl font-extrabold uppercase leading-none tracking-tight md:col-span-4 md:text-5xl">What is mendxz<span class="text-accent">?</span></h2>
      <div class="space-y-5 text-lg leading-relaxed md:col-span-7 md:col-start-6">
        <p>{SITE.name} is a one-person studio that designs, builds and supports every app in-house. Each project is small on purpose: fast to load, respectful of your time, and free of dark patterns.</p>
        <p>Need help with an app? Every app has its own <a class="underline decoration-accent decoration-2 underline-offset-4" href="/support">support page</a>, or email <a class="underline decoration-accent decoration-2 underline-offset-4" href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
