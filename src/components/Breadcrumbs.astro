---
export interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="label text-muted">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        {i < items.length - 1 ? (
          <><a href={it.path} class="hover:text-ink underline-offset-4 hover:underline">{it.name}</a><span aria-hidden="true">/</span></>
        ) : (
          <span aria-current="page" class="text-ink">{it.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
