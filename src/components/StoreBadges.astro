---
import type { CollectionEntry } from 'astro:content';
export interface Props { app: CollectionEntry<'apps'>['data'] }
const { app } = Astro.props;
const stores = [
  app.platforms.includes('ios') && { label: 'App Store', sub: 'Download on the', url: app.appStoreUrl, icon: 'apple' },
  app.platforms.includes('android') && { label: 'Google Play', sub: 'Get it on', url: app.playStoreUrl, icon: 'play' },
].filter(Boolean) as { label: string; sub: string; url?: string; icon: string }[];
---
<div class="flex flex-wrap gap-3">
  {stores.map((s) => {
    const live = app.status === 'live' && s.url;
    const Tag = live ? 'a' : 'div';
    return (
      <Tag
        {...(live ? { href: s.url, rel: 'noopener', target: '_blank' } : { 'aria-disabled': 'true' })}
        class:list={['btn min-w-48', !live && 'btn-ghost cursor-default hover:!translate-0 hover:!shadow-none hover:!bg-transparent']}
      >
        {s.icon === 'apple' ? (
          <svg viewBox="0 0 24 24" class="size-6" fill="currentColor" aria-hidden="true"><path d="M16.37 12.6c-.02-2.2 1.8-3.27 1.88-3.32-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.69 0-1.74-.78-2.86-.76-1.47.02-2.83.86-3.59 2.17-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.24 2.73 2.2 1.1-.04 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.13.84-1.22 1.18-2.41 1.2-2.47-.03-.01-2.3-.88-2.3-3.5zM14.2 6.13c.6-.73 1.01-1.75.9-2.76-.87.04-1.92.58-2.54 1.31-.56.64-1.05 1.67-.92 2.66.97.08 1.96-.49 2.56-1.21z"/></svg>
        ) : (
          <svg viewBox="0 0 24 24" class="size-6" fill="currentColor" aria-hidden="true"><path d="M4 2.8v18.4c0 .5.5.8.9.6l16-9.2c.4-.2.4-.9 0-1.1l-16-9.3C4.5 2 4 2.3 4 2.8z"/></svg>
        )}
        <span class="flex flex-col leading-tight text-left">
          <span class="text-[0.7rem] font-normal opacity-70">{live ? s.sub : 'Coming soon to'}</span>
          <span>{s.label}</span>
        </span>
      </Tag>
    );
  })}
</div>
